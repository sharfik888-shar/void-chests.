
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#090710">
<title>VOID CHESTS</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<style>
*{box-sizing:border-box}
body{
 margin:0;background:#090710;color:#fff1ff;
 font-family:Arial,sans-serif;
 background-image:radial-gradient(ellipse at top,#39105c,transparent 55%);
 min-height:100vh
}
button{cursor:pointer;font:inherit}
.app{max-width:460px;margin:auto;padding:22px 17px}
header{display:flex;justify-content:space-between;align-items:center}
.logo{font-weight:900;letter-spacing:2px;font-size:20px}
.logo span{color:#c084fc}
.badge{font-size:11px;color:#d8b4fe;background:#241333;padding:9px;border-radius:20px}
.balance{margin-top:24px;padding:17px;background:#171020;border:1px solid #48236d;border-radius:16px;display:flex;justify-content:space-between}
.muted{color:#a99bb8;font-size:12px}
.coins{font-size:27px;font-weight:bold;margin-top:7px}
.hero{margin-top:20px;text-align:center;padding:24px 14px;background:linear-gradient(#211333,#100c19);border:1px solid #42205b;border-radius:22px}
.chest{font-size:95px;filter:drop-shadow(0 0 20px #a855f7);transition:.3s}
.shake{animation:shake .45s infinite}
@keyframes shake{25%{transform:rotate(-8deg) scale(1.06)}75%{transform:rotate(8deg) scale(1.06)}}
h1{font-size:23px}
p{font-size:13px;line-height:1.5;color:#b7a8c6}
.primary{width:100%;padding:15px;border:0;border-radius:12px;background:linear-gradient(100deg,#7c3aed,#c026d3);color:white;font-weight:bold}
.primary:disabled{opacity:.5}
.cost{font-size:12px;color:#cbb6e8;margin-top:12px}
.reward{display:none;margin-top:17px;padding:17px;background:#211332;border:1px solid #a855f7;border-radius:15px}
.reward-icon{font-size:60px}
.actions,.tabs{display:flex;gap:10px;margin-top:16px}
.secondary,.tab{flex:1;padding:12px 5px;border:1px solid #49335d;border-radius:12px;background:#171020;color:white}
.tab.active{background:#321648;border-color:#c084fc}
.panel{display:none}
.panel.active{display:block}
h2{font-size:20px;margin-top:26px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.item{background:#151020;border:1px solid #382446;border-radius:15px;padding:15px 6px;text-align:center;overflow-wrap:anywhere}
.item-icon{font-size:42px}
.item-name{font-size:13px;font-weight:bold;margin-top:8px}
.rarity{font-size:11px;color:#c084fc;margin-top:7px}
.count{font-size:11px;color:#9686a5;margin-top:7px}
.notice{font-size:11px;color:#82758e;text-align:center;line-height:1.5;margin-top:25px}
.empty{grid-column:1/-1;text-align:center;padding:25px;color:#a99bb8;font-size:13px}
</style>
</head>
<body>
<div class="app">
<header>
 <div class="logo">VOID <span>CHESTS</span></div>
 <div class="badge">✦ COLLECTION</div>
</header>

<div class="balance">
 <div><div class="muted">ТВОЙ БАЛАНС</div><div class="coins">🪙 <span id="coins">500</span></div></div>
 <div style="text-align:right"><div class="muted">УРОВЕНЬ</div><div class="coins">01</div></div>
</div>

<div class="hero">
 <div class="chest" id="chest">🎁</div>
 <h1>VOID CHEST</h1>
 <p>Открывай сундуки и собирай<br>свою уникальную коллекцию.</p>
 <button class="primary" id="openBtn" onclick="openChest()">ОТКРЫТЬ СУНДУК</button>
 <div class="cost">🪙 Стоимость: 100 игровых монет</div>
 <div class="reward" id="reward">
  <div class="reward-icon" id="rewardIcon"></div>
  <h3 id="rewardName"></h3>
  <div class="rarity" id="rewardRarity"></div>
  <p>Предмет добавлен в коллекцию!</p>
 </div>
</div>

<div class="actions">
 <button class="secondary" onclick="dailyBonus()">🎁 Бонус +150</button>
 <button class="secondary" onclick="showTab('collection')">💎 Коллекция</button>
</div>

<div class="tabs">
 <button class="tab active" id="tab-chests" onclick="showTab('chests')">Сундуки</button>
 <button class="tab" id="tab-collection" onclick="showTab('collection')">Коллекция</button>
</div>

<section class="panel active" id="panel-chests">
 <h2>Твои сундуки</h2>
 <div class="grid">
  <div class="item"><div class="item-icon">📦</div><div class="item-name">VOID BOX</div><div class="rarity">Обычный</div><div class="count">100 монет</div></div>
  <div class="item"><div class="item-icon">🟣</div><div class="item-name">NEON BOX</div><div class="rarity">Эпический стиль</div><div class="count">Скоро</div></div>
 </div>
</section>

<section class="panel" id="panel-collection">
 <h2>Моя коллекция</h2>
 <div class="grid" id="inventory"></div>
</section>

<div class="notice">VOID CHESTS · DEMO VERSION<br>Монеты и предметы виртуальные. Прогресс хранится на устройстве.</div>
</div>

<script>
const tg=window.Telegram?.WebApp;
tg?.ready();
tg?.expand();

const defaults={coins:500,inventory:{},lastBonus:"",totalOpened:0};
let state;
try{
 state=JSON.parse(localStorage.getItem("void_save"))||{...defaults};
}catch(e){state={...defaults};}

const items=[
 {id:"star",name:"Cosmic Star",icon:"⭐",rarity:"Обычный",weight:50,color:"#bda5d5"},
 {id:"rose",name:"Neon Rose",icon:"🌹",rarity:"Редкий",weight:28,color:"#ff65b5"},
 {id:"crystal",name:"Void Crystal",icon:"💎",rarity:"Эпический",weight:15,color:"#59d8ff"},
 {id:"crown",name:"Phantom Crown",icon:"👑",rarity:"Легендарный",weight:6,color:"#ffd166"},
 {id:"portal",name:"Dark Portal",icon:"🌀",rarity:"Мифический",weight:1,color:"#c084fc"}
];

function save(){
 try{localStorage.setItem("void_save",JSON.stringify(state));}catch(e){}
 render();
}
function render(){
 document.getElementById("coins").textContent=state.coins;
 const inv=document.getElementById("inventory");
 const owned=items.filter(x=>(state.inventory[x.id]||0)>0);
 inv.innerHTML=owned.length?owned.map(x=>`
 <div class="item" style="border-color:${x.color}">
 <div class="item-icon">${x.icon}</div>
 <div class="item-name">${x.name}</div>
 <div class="rarity" style="color:${x.color}">${x.rarity}</div>
 <div class="count">Количество: ${state.inventory[x.id]}</div>
 </div>`).join(""):'<div class="empty">Коллекция пока пуста.<br>Открой первый сундук!</div>';
}
function pickItem(){
 const total=items.reduce((s,x)=>s+x.weight,0);
 let n=Math.random()*total;
 for(const x of items){n-=x.weight;if(n<0)return x;}
 return items[0];
}
function openChest(){
 if(state.coins<100){alert("Недостаточно монет! Забери бонус.");return;}
 const btn=document.getElementById("openBtn");
 const chest=document.getElementById("chest");
 btn.disabled=true;
 document.getElementById("reward").style.display="none";
 state.coins-=100;
 save();
 chest.classList.add("shake");
 chest.textContent="📦";
 setTimeout(()=>{
  const x=pickItem();
  state.inventory[x.id]=(state.inventory[x.id]||0)+1;
  state.totalOpened++;
  chest.classList.remove("shake");
  chest.textContent=x.icon;
  document.getElementById("rewardIcon").textContent=x.icon;
  document.getElementById("rewardName").textContent=x.name;
  const r=document.getElementById("rewardRarity");
  r.textContent=x.rarity;
  r.style.color=x.color;
  document.getElementById("reward").style.display="block";
  btn.disabled=false;
  save();
 },850);
}
function dailyBonus(){
 const today=new Date().toISOString().slice(0,10);
 if(state.lastBonus===today){alert("Ты уже забрал бонус сегодня!");return;}
 state.lastBonus=today;
 state.coins+=150;
 save();
 alert("Получено +150 монет!");
}
function showTab(t){
 document.querySelectorAll(".panel").forEach(x=>x.classList.remove("active"));
 document.querySelectorAll(".tab").forEach(x=>x.classList.remove("active"));
 document.getElementById("panel-"+t).classList.add("active");
 document.getElementById("tab-"+t).classList.add("active");
}
render();
</script>
</body>
</html>
